CHAT_RELAY_ADDR=127.0.0.1:6697
CHAT_RELAY_AUTH_TOKEN=

# Token admission is on by default. Disable only behind server-enforced VPN isolation.
CHAT_RELAY_REQUIRE_AUTH_TOKEN=true
# Required for token-free non-loopback binds; does not enforce VPN isolation itself.
CHAT_RELAY_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false

# VPN-only mode: bind to one non-loopback address on this Linux interface.
CHAT_RELAY_VPN_ONLY=false
CHAT_RELAY_VPN_INTERFACE=
# Set only for a gateway on a trusted private ingress; exact source IP required.
CHAT_RELAY_VPN_GATEWAY_IP=

# Set both paths to readable PEM files to enable TLS (required outside loopback).
# Leave both empty to use plaintext on loopback only.
CHAT_RELAY_TLS_CERT=
CHAT_RELAY_TLS_KEY=
