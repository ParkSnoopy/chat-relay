CHAT_RELAY_ADDR=0.0.0.0:6697
CHAT_RELAY_ALLOWED_HOST=127.0.0.1,localhost,192.168.0.0/24

# Maximum bytes per incoming NDJSON frame, excluding its newline.
# This is not a total file-size limit: clients can send files in bounded chunks.
CHAT_RELAY_MAX_CONTENT_SIZE=262144

# Set both paths to readable PEM files to enable TLS.
# Leave both empty to use plaintext.
CHAT_RELAY_TLS_CERT=
CHAT_RELAY_TLS_KEY=
